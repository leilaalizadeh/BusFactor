# Copy to .env (never commit .env). With DEMO_MODE=true everything runs offline on synthetic data.
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
DEMO_MODE=true

# Optional
# BUSFACTOR_DB=busfactor.db            # SQLite file (in Docker: /data/busfactor.db)
# BUSFACTOR_UPLOADS=uploads            # folder for uploaded project documents
# BUSFACTOR_REMINDER_DAYS=2            # idle accepted mission -> reminder
# BUSFACTOR_FOLLOWUP_DAYS=3            # days after a passed retest before the follow-up question
